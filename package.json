{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch --watch-path=server.ts --watch-path=src/lib/routes-config.ts --watch-path=src/lib/serverAiGenerator.ts server.ts",
    "test:invariants": "tsx scripts/verify-invariants.ts",
    "audit:diagrams": "tsx scripts/audit-database-diagram-integrity.ts",
    "build": "npm run test:invariants && vite build --outDir=build && esbuild server.ts --bundle --platform=node --format=esm --outfile=build/server.js --packages=external",
    "build:frontend": "vite build --outDir=build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --outfile=build/server.js --packages=external",
    "preview": "vite preview",
    "clean": "rm -rf build",
    "lint": "npm run test:invariants && tsc --noEmit",
    "start": "node build/server.js"
  },
  "dependencies": {
    "@andresaya/edge-tts": "^1.8.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/status-bar": "^8.0.4",
    "@google/genai": "^1.29.0",
    "@supabase/supabase-js": "^2.103.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/dompurify": "^3.0.5",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.2",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "framer-motion": "^12.38.0",
    "katex": "^0.19.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.4"
  },
  "overrides": {
    "proxy-addr": "^2.0.8",
    "esbuild": "^0.28.2",
    "uuid": "^11.1.1"
  }
}
